---
import { getCollection } from "astro:content";
import PostPreviewCard from "../components/PostPreviewCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  experience,
  focusAreas,
  professionalSummary,
  selectedProjects,
  siteMeta
} from "../data/profile";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const latestPosts = posts.slice(0, 3);
const spotlightProjects = selectedProjects.slice(0, 3);
---

<BaseLayout
  title="Applied AI Engineer"
  description={siteMeta.description}
>
  <section class="container hero reveal" style="--delay: 90ms">
    <div class="hero-copy">
      <p class="eyebrow">Reza Ghalavand</p>
      <h1 class="hero-title">Applied AI Engineer</h1>
      <p class="hero-subtitle">{siteMeta.tagline}</p>
      <p>{professionalSummary}</p>
      <div class="hero-actions">
        <a class="button button--primary" href="/projects/">Explore AI Systems</a>
        <a class="button button--ghost" href={siteMeta.github}>View GitHub</a>
        <a class="button button--ghost" href={siteMeta.resumePath} target="_blank" rel="noreferrer">
          Download resume
        </a>
      </div>
      <p class="profile-note">
        <a href={siteMeta.linkedin}>LinkedIn</a> · <a href={`mailto:${siteMeta.email}`}>Email</a>
      </p>
    </div>

    <figure class="profile-frame">
      <img
        src="/assets/images/profile-img.jpg"
        alt="Professional portrait of Reza Ghalavand"
        class="profile-image"
        loading="eager"
      />
      <figcaption class="profile-note">
        LLM applications, retrieval, and agent evaluation backed by deep software engineering experience.
      </figcaption>
    </figure>
  </section>

  <section class="container section">
    <SectionHeading
      overline="Selected projects"
      title="Open-source work"
      description="A portfolio focused on pragmatic AI engineering, governance, and enterprise backend systems."
    />
    <div class="card-grid">
      {spotlightProjects.map((project, index) => (
        <div style={`--delay: ${160 + index * 70}ms`}>
          <ProjectCard {...project} />
        </div>
      ))}
    </div>
  </section>

  <section class="container section">
    <div class="stat-strip">
      <article class="stat-item reveal" style="--delay: 140ms">
        <strong>15+ Years</strong>
        <span>Enterprise software delivery</span>
      </article>
      <article class="stat-item reveal" style="--delay: 220ms">
        <strong>6 Repositories</strong>
        <span>Applied AI and backend systems</span>
      </article>
      <article class="stat-item reveal" style="--delay: 300ms">
        <strong>3 AI Case Studies</strong>
        <span>RAG, agent governance, AI architecture</span>
      </article>
      <article class="stat-item reveal" style="--delay: 380ms">
        <strong>{posts.length} Articles</strong>
        <span>Technical writing from 2024 to present</span>
      </article>
    </div>
  </section>

  <section class="container section">
    <SectionHeading
      overline="Current focus"
      title="What I am building and improving"
      description="My projects expose architecture, implementation status, and limitations so you can inspect the engineering decisions."
    />
    <div class="card-grid">
      {focusAreas.map((item, index) => (
        <article class="competency-card reveal" style={`--delay: ${180 + index * 80}ms`}>
          <h3>{item}</h3>
          <p>
            Inspect the project explorer for implementation evidence, design trade-offs, and remaining work.
          </p>
        </article>
      ))}
    </div>
  </section>



  <section class="container section">
    <SectionHeading
      overline="Recent writing"
      title="AI architecture and engineering notes"
      description="Writing focused on architecture trade-offs, AI integration patterns, and operational reliability."
    />
    <div class="card-grid">
      {latestPosts.map((post, index) => (
        <div style={`--delay: ${160 + index * 70}ms`}>
          <PostPreviewCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id}`}
            date={post.data.publishedAt}
            readingTime={post.data.readingTime}
            tags={post.data.tags}
          />
        </div>
      ))}
    </div>
  </section>

  <section class="container section">
    <SectionHeading
      overline="Professional experience"
      title="Career highlights"
      description="A condensed timeline from resume responsibilities across enterprise systems and software delivery."
    />
    <ol class="timeline reveal" style="--delay: 180ms">
      {experience.map((entry) => (
        <li>
          <h3>{entry.title}</h3>
          <p class="period">
            {entry.company} | {entry.period}
          </p>
          <ul>
            {entry.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
