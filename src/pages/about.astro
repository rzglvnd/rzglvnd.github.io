---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import {
  competencies,
  education,
  experience,
  professionalSummary,
  siteMeta
} from "../data/profile";
---

<BaseLayout
  title="About"
  description="Reza Ghalavand is an Applied AI Engineer building LLM, RAG, and agent evaluation systems on a foundation of enterprise software engineering."
>
  <section class="container hero reveal" style="--delay: 120ms">
    <div class="hero-copy">
      <p class="eyebrow">About</p>
      <h1 class="hero-title">Reza Ghalavand</h1>
      <p class="hero-subtitle">Applied AI Engineer | LLM Systems, RAG, Agents and Evaluation</p>
      <p>{professionalSummary}</p>
      <p>My work in enterprise backends, SQL Server, automation, and infrastructure shaped how I build AI software: define interfaces, preserve state deliberately, test failure paths, and make behavior inspectable. Today that practice connects retrieval and model adapters in Local LLM Chat Engine, policy checks in LangGraph Governance Lab, and architecture guidance in AI Systems Notes.</p>
      <div class="hero-actions">
        <a class="button button--primary" href={siteMeta.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="button button--ghost" href={siteMeta.github} target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </div>
    <figure class="profile-frame">
      <img
        src="/assets/images/profile-img.jpg"
        alt="Reza Ghalavand portrait"
        class="profile-image"
        loading="lazy"
      />
      <figcaption class="profile-note">Email: {siteMeta.email}</figcaption>
    </figure>
  </section>

  <section class="container section">
    <SectionHeading
      overline="Core competencies"
      title="Technical strengths"
      description="Hands-on across software engineering, data platforms, and enterprise AI enablement."
    />
    <div class="card-grid">
      {competencies.map((group, index) => (
        <article class="competency-card reveal" style={`--delay: ${160 + index * 55}ms`}>
          <h3>{group.category}</h3>
          <ul class="chip-list" aria-label={`${group.category} skills`}>
            {group.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="container section">
    <SectionHeading
      overline="Experience"
      title="Professional timeline"
      description="Official employment titles and responsibilities. This software engineering history supports my current applied AI project work."
    />
    <ol class="timeline reveal" style="--delay: 180ms">
      {experience.map((entry) => (
        <li>
          <h3>{entry.title}</h3>
          <p class="period">
            {entry.company} | {entry.period}
          </p>
          <ul>
            {entry.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <section class="container section reveal" style="--delay: 220ms">
    <SectionHeading overline="Education" title={education.degree} description={education.institution} />
  </section>
</BaseLayout>
