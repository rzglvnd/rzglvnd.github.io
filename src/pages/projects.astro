---
import AIPortfolioExplorer from "../components/AIPortfolioExplorer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { selectedProjects } from "../data/profile";
---

<BaseLayout
  pageClass="portfolio-page"
  title="AI Portfolio Explorer"
  description="Explore Reza Ghalavand’s AI case studies, architectures, and technologies. Compare work across RAG, agents, evaluation, backend engineering, and ops."
>
  <AIPortfolioExplorer />
  <section class="container section">
    <SectionHeading
      overline="More engineering work"
      title="Additional repositories"
      description="Explore additional work across enterprise automation, analytics, and system design."
    />
    <div class="card-grid">
      {selectedProjects.slice(3).map((project, index) => (
        <div style={`--delay: ${140 + index * 70}ms`}>
          <ProjectCard {...project} />
        </div>
      ))}
    </div>
  </section>

  <section class="container section reveal" style="--delay: 200ms">
    <div class="notice">
      <p>
        Supporting technical work:{" "}
        <a class="text-link" href="https://github.com/rzglvnd/python-system-lab" target="_blank" rel="noreferrer">Python System Lab</a>{" "}
        is an early-stage experimental repository examining execution timing and failure propagation in Python iteration, with reproducible traces and tests on Python 3.11 and 3.13.
      </p>
    </div>
  </section>
</BaseLayout>
