---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { selectedProjects } from "../data/profile";
---

<BaseLayout
  title="Projects"
  description="Selected open-source repositories by Reza Ghalavand covering backend engineering and practical AI systems."
>
  <section class="container section">
    <SectionHeading
      overline="Projects"
      title="Portfolio repositories"
      description="Each repository is designed as a production-quality implementation with testing, documentation, and operational clarity."
    />
    <div class="card-grid">
      {selectedProjects.map((project, index) => (
        <div style={`--delay: ${140 + index * 70}ms`}>
          <ProjectCard {...project} />
        </div>
      ))}
    </div>
  </section>

  <section class="container section reveal" style="--delay: 200ms">
    <div class="notice">
      <p>
        Supporting technical work:{" "}
        <a class="text-link" href="https://github.com/rzglvnd/python-system-lab" target="_blank" rel="noreferrer">Python System Lab</a>{" "}
        is an early-stage experimental repository examining execution timing and failure propagation in Python iteration, with reproducible traces and tests on Python 3.11 and 3.13.
      </p>
    </div>
  </section>
</BaseLayout>
