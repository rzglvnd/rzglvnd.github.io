---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  readingTime: string;
}

const { title, description, publishedAt, updatedAt, tags = [], readingTime } = Astro.props;

const publishedLabel = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric"
}).format(publishedAt);

const updatedLabel =
  updatedAt &&
  new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "long",
    day: "numeric"
  }).format(updatedAt);
---

<BaseLayout title={title} description={description}>
  <article class="container narrow blog-layout reveal" style="--delay: 120ms">
    <p class="eyebrow">Technical Blog</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    <div class="blog-meta">
      <span>Published {publishedLabel}</span>
      <span>{readingTime}</span>
      {updatedLabel && <span>Updated {updatedLabel}</span>}
    </div>
    {tags.length > 0 && (
      <ul class="chip-list" aria-label="Article tags">
        {tags.map((tag) => (
          <li class="chip">{tag}</li>
        ))}
      </ul>
    )}
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
